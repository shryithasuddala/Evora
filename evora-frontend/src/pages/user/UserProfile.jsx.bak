import { useState } from "react";
import {
  UserRound,
  Mail,
  Phone,
  MapPin,
  Save,
  CheckCircle2,
} from "lucide-react";
import { useAuth } from "../../context/useAuth";

const UserProfile = () => {
  const { currentUser, updateProfile } = useAuth();

  const [formData, setFormData] = useState({
    fullName: currentUser?.fullName || "",
    email: currentUser?.email || "",
    phone: currentUser?.phone || "",
    city: currentUser?.city || "Hyderabad",
    bio: currentUser?.bio || "",
  });

  const [saved, setSaved] = useState(false);

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
    setSaved(false);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    try {
      await updateProfile(formData);
      setSaved(true);
      setTimeout(() => setSaved(false), 3000);
    } catch (err) {
      alert(err.message || "Failed to update profile");
    }
  };

  return (
    <div className="vendor-page">
      <div style={{ marginBottom: "24px" }}>
        <span className="vendor-welcome-label" style={{ color: "#C9A13A" }}>
          ORGANIZER CREDENTIALS
        </span>
        <h1 style={{ fontFamily: "Playfair Display, serif", fontSize: "32px", margin: "4px 0" }}>
          Personal Profile & Settings
        </h1>
        <p style={{ margin: 0, color: "#766C67" }}>
          Manage your contact credentials and celebration planning preferences.
        </p>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "1fr 2fr", gap: "24px" }}>
        {/* AVATAR CARD */}
        <div className="vendor-card" style={{ textAlign: "center", padding: "36px 20px" }}>
          <div
            style={{
              width: "80px",
              height: "80px",
              borderRadius: "50%",
              background: "#304B35",
              color: "#FFF",
              display: "grid",
              placeItems: "center",
              fontSize: "32px",
              fontFamily: "Playfair Display, serif",
              margin: "0 auto 16px",
            }}
          >
            {formData.fullName.charAt(0).toUpperCase() || "U"}
          </div>

          <h2 style={{ fontFamily: "Playfair Display, serif", fontSize: "20px", margin: "0 0 4px" }}>
            {formData.fullName}
          </h2>
          <span
            style={{
              fontSize: "11px",
              fontWeight: 700,
              letterSpacing: "0.8px",
              background: "#E7D9D4",
              color: "#2E2927",
              padding: "3px 10px",
              borderRadius: "999px",
              textTransform: "uppercase",
              display: "inline-block",
              marginBottom: "12px",
            }}
          >
            Event Host & Organizer
          </span>

          <p style={{ fontSize: "13px", color: "#766C67", margin: "0 0 16px" }}>
            {formData.city || "Hyderabad"}
          </p>

          <div style={{ borderTop: "1px solid #E7DED5", paddingTop: "16px", fontSize: "12px", color: "#766C67" }}>
            Member of EVORA Platform since 2026
          </div>
        </div>

        {/* PROFILE EDIT FORM */}
        <div className="vendor-card">
          {saved && (
            <div
              style={{
                background: "#D4EDDA",
                color: "#155724",
                padding: "12px 16px",
                borderRadius: "8px",
                marginBottom: "20px",
                display: "flex",
                alignItems: "center",
                gap: "8px",
                fontSize: "13px",
              }}
            >
              <CheckCircle2 size={16} /> Profile changes saved successfully!
            </div>
          )}

          <form onSubmit={handleSubmit} style={{ display: "flex", flexDirection: "column", gap: "16px" }}>
            <div className="login-field">
              <label>Full Name</label>
              <div className="login-input-wrapper">
                <UserRound size={16} />
                <input
                  name="fullName"
                  value={formData.fullName}
                  onChange={handleChange}
                  required
                />
              </div>
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "16px" }}>
              <div className="login-field">
                <label>Email Address</label>
                <div className="login-input-wrapper">
                  <Mail size={16} />
                  <input
                    name="email"
                    type="email"
                    value={formData.email}
                    onChange={handleChange}
                    required
                  />
                </div>
              </div>

              <div className="login-field">
                <label style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                  <span>Phone Number</span>
                  <span style={{ fontSize: "11px", color: "#25D366", background: "#E8F9EE", padding: "2px 8px", borderRadius: "10px", fontWeight: 700 }}>
                    WhatsApp Active
                  </span>
                </label>
                <div className="login-input-wrapper">
                  <Phone size={16} />
                  <input
                    name="phone"
                    placeholder="+91 98765 43210"
                    value={formData.phone}
                    onChange={handleChange}
                  />
                </div>
                <p style={{ margin: "4px 0 0", fontSize: "11px", color: "#8B7355" }}>
                  Update your number anytime. All WhatsApp proposals and celebration confirmations will be routed here.
                </p>
              </div>
            </div>

            <div className="login-field">
              <label>City / Region</label>
              <div className="login-input-wrapper">
                <MapPin size={16} />
                <input
                  name="city"
                  value={formData.city}
                  onChange={handleChange}
                />
              </div>
            </div>

            <div className="login-field">
              <label>Bio / About You</label>
              <textarea
                name="bio"
                rows={3}
                value={formData.bio}
                onChange={handleChange}
                style={{
                  width: "100%",
                  padding: "10px",
                  border: "1px solid #E7DED5",
                  borderRadius: "8px",
                  fontFamily: "inherit",
                  fontSize: "13px",
                }}
              />
            </div>

            <div style={{ display: "flex", justifyContent: "flex-end" }}>
              <button
                type="submit"
                className="vendor-primary-button"
                style={{ display: "flex", alignItems: "center", gap: "8px", padding: "10px 24px" }}
              >
                <Save size={16} /> Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  );
};

export default UserProfile;
