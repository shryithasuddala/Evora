PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@evora.uxy5uqw.mongodb.net/evora?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# EMAIL OTP CONFIGURATION (NODEMAILER)
# For Gmail: Use a Google App Password (not your normal password)
# 1. Go to Google Account > Security > 2-Step Verification
# 2. At bottom, click "App passwords" > Create name "EVORA"
# 3. Paste the 16-character code below as SMTP_PASS
# ─────────────────────────────────────────────────────────────
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="EVORA Celebrations" <your_email@gmail.com>

# ─────────────────────────────────────────────────────────────
# AUTOMATIC WHATSAPP DISPATCH
# Mode: 'demo' simulates dispatch with zero provider charges;
#       'live' sends real WhatsApp messages via Twilio or Meta.
# ─────────────────────────────────────────────────────────────
TWILIO_MODE=demo

# Option A: Twilio WhatsApp Business / Sandbox API
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token   # Required for webhook X-Twilio-Signature validation
# Optional API Key auth (TWILIO_AUTH_TOKEN is still needed for webhooks):
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_STATUS_CALLBACK_URL=https://your-public-domain.com/api/notifications/twilio-status
# Optional approved Twilio Content Template SIDs (for business-initiated messages outside 24h window):
# TWILIO_CONTENT_SID_DEFAULT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CONTENT_SID_BOOKING_CONFIRMED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CONTENT_SID_EVENT_APPROVED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Meta WhatsApp Cloud API (Graph API)
# WHATSAPP_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_ID=your_meta_phone_number_id
# META_VERIFY_TOKEN=your_meta_webhook_verify_token
# META_APP_SECRET=your_meta_app_secret
# WHATSAPP_HTTP_TIMEOUT_MS=10000
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# AI INTEGRATION (GOOGLE GEMINI)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
